  - {fileID: 114350483966675130}
  - {fileID: 114350483966675131}
  - {fileID: 114350483966675132}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675109}
  m_BlockName: Custom HLSL
  m_HLSLCode: '#include "Assets/LineLab/Shaders/LineCommon.hlsl"

    void DrawLine(inout
    VFXAttributes attributes, in float4 Start, in float4 End, in float4 Tint, in
    float4 Shape, in uint Segments, in float Clock, in float3 CameraPosition)

    {

    LabLine
    l; l.start=Start; l.end=End; l.color=Tint; l.shape=Shape;

    uint segment=attributes.particleId%Segments;
    float t=(segment+.5)/Segments;

    float3 a=LabPoint(l,(float)segment/Segments,Clock);
    float3 b=LabPoint(l,(float)(segment+1)/Segments,Clock); float3 mid=(a+b)*.5;

    float3
    tangent=normalize(b-a+float3(1e-7,0,0)); float3 side=normalize(cross(normalize(CameraPosition-mid),tangent));
    float4 color=LabTint(l,t,Clock);

    attributes.position=mid; attributes.axisX=tangent;
    attributes.axisY=side; attributes.axisZ=normalize(cross(tangent,side));

    attributes.size=1;
    attributes.scaleX=distance(a,b)*1.035; attributes.scaleY=l.end.w; attributes.scaleZ=1;
    attributes.color=color.rgb; attributes.alpha=color.a;

    }'
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawLine
    selectedIndex: 0

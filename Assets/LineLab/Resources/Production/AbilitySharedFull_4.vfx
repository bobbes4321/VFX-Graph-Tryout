  - {fileID: 114350483966675369}
  - {fileID: 114350483966675370}
  - {fileID: 114350483966675371}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675368}
  m_BlockName: Custom HLSL
  m_HLSLCode: '#include "Assets/LineLab/Production/Shaders/AbilityCommon.hlsl"

    void
    DrawAbility(inout VFXAttributes attributes, in StructuredBuffer<float4> Lines,
    in float Clock, in float3 CameraPosition)

    { AbilityLine l;uint offset=(attributes.particleId/8)*4;
    l.start=Lines[offset];l.end=Lines[offset+1];l.color=Lines[offset+2];l.shape=Lines[offset+3];Adornment
    d;AbilityDecor(l,2,attributes.particleId%8,Clock,CameraPosition,d);attributes.position=d.Position;attributes.axisX=d.X;attributes.axisY=d.Y;attributes.axisZ=cross(d.X,d.Y);attributes.size=1;attributes.scaleX=d.Size.x;attributes.scaleY=d.Size.y;attributes.scaleZ=1;attributes.color=d.Color;attributes.alpha=d.Alpha;
    }'
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawAbility
    selectedIndex: 0

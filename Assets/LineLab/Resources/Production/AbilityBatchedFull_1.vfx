  m_BlockName: Custom HLSL
  m_HLSLCode: '#include "Assets/LineLab/Production/Shaders/AbilityCommon.hlsl"

    void
    DrawAbility(inout VFXAttributes attributes, in float4 Start, in float4 End, in
    float4 Tint, in float4 Shape, in float Clock, in float3 CameraPosition)

    {
    AbilityLine l;l.start=Start;l.end=End;l.color=Tint;l.shape=Shape;Adornment d;AbilityDecor(l,0,attributes.particleId%48,Clock,CameraPosition,d);attributes.position=d.Position;attributes.axisX=d.X;attributes.axisY=d.Y;attributes.axisZ=cross(d.X,d.Y);attributes.size=1;attributes.scaleX=d.Size.x;attributes.scaleY=d.Size.y;attributes.scaleZ=1;attributes.color=d.Color;attributes.alpha=d.Alpha;
    }'
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawAbility
    selectedIndex: 0

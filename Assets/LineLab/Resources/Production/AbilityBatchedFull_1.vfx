  m_ActivationSlot: {fileID: 114350483966675381}
  m_BlockName: Custom HLSL
  m_HLSLCode: '#include "Assets/LineLab/Production/Shaders/AbilityCommon.hlsl"

    void
    DrawAbility(inout VFXAttributes attributes, in float4 Start, in float4 End, in
    float4 Tint, in float4 Shape, in float Clock, in float3 CameraPosition)

    {
    AbilityLine l;l.start=Start;l.end=End;l.color=Tint;l.shape=Shape;uint strand=(attributes.particleId%96)/32;uint
    s=attributes.particleId%32;l=AbilityStrand(l,strand,Clock);float3 a=AbilityPoint(l,(float)s/32,Clock),b=AbilityPoint(l,(s+1.0)/32,Clock);float3
    mid=(a+b)*.5;float3 x=normalizesafe(b-a,float3(1,0,0));float3 y=normalizesafe(cross(normalize(CameraPosition-mid),x),float3(0,1,0));float4
    c=AbilityTint(l,(s+.5)/32,Clock);attributes.position=mid;attributes.axisX=x;attributes.axisY=y;attributes.axisZ=cross(x,y);attributes.size=1;attributes.scaleX=distance(a,b)*1.035;attributes.scaleY=l.end.w;attributes.scaleZ=1;attributes.color=c.rgb;attributes.alpha=c.a;
    }'
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawAbility
    selectedIndex: 0

  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966678500}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966678522}
  - {fileID: 114350483966678523}
  - {fileID: 114350483966678524}
  - {fileID: 114350483966678525}
  - {fileID: 114350483966678526}
  - {fileID: 114350483966678527}
  - {fileID: 114350483966678528}
  - {fileID: 114350483966678532}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966678521}
  m_BlockName: Custom HLSL
  m_HLSLCode: "#include \"Assets/LineLab/Production/Shaders/AbilityCommon.hlsl\"\r\nvoid
    DrawAuthoredAbility(inout VFXAttributes attributes,\r\n    in StructuredBuffer<float4>
    Lines,\r\n    in StructuredBuffer<float4> Effects, in StructuredBuffer<float4>
    Ribbons,\r\n    in StructuredBuffer<float4> Layers, in StructuredBuffer<float4>
    Ramps,\r\n    in float Clock, in float3 CameraPosition, in float2 AtlasGrid)\r\n{\r\n   
    AbilityLine beam;\r\n    \r\n    uint lineIndex = attributes.particleId / 48;\r\n   
    beam.start = Lines[lineIndex * 4];\r\n    beam.end = Lines[lineIndex * 4 + 1];\r\n   
    beam.color = Lines[lineIndex * 4 + 2];\r\n    beam.shape = Lines[lineIndex *
    4 + 3];\r\n    uint effectIndex = (uint)beam.shape.x;\r\n    EffectRecipeData
    recipe = AbilityLoadEffect(Effects,effectIndex);\r\n    \r\n    LayerRecipeData
    layer = AbilityLoadLayer(Layers, effectIndex * 5 + 0);\r\n    Adornment card;\r\n   
    AbilityDecor(beam,recipe,layer,attributes.particleId % 48,Clock,CameraPosition,Ramps,card);\r\n   
    attributes.position = card.Position;\r\n    attributes.axisX = card.X;\r\n   
    attributes.axisY = card.Y;\r\n    attributes.axisZ = cross(card.X,card.Y);\r\n   
    attributes.scaleX = card.Size.x;\r\n    attributes.scaleY = card.Size.y;\r\n   
    attributes.color = card.Color;\r\n    attributes.alpha = card.Alpha;\r\n    attributes.texIndex
    = (AtlasGrid.y - 1 - floor(card.TextureIndex / AtlasGrid.x)) * AtlasGrid.x +
    fmod(card.TextureIndex, AtlasGrid.x);\r\n    attributes.size = 1;\r\n    attributes.scaleZ
    = 1;\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawAuthoredAbility
    selectedIndex: 0

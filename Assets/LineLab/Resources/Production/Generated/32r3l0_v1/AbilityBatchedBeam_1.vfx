  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966675544}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966675566}
  - {fileID: 114350483966675571}
  - {fileID: 114350483966675576}
  - {fileID: 114350483966675581}
  - {fileID: 114350483966675586}
  - {fileID: 114350483966675587}
  - {fileID: 114350483966675588}
  - {fileID: 114350483966675589}
  - {fileID: 114350483966675590}
  - {fileID: 114350483966675591}
  - {fileID: 114350483966675595}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675565}
  m_BlockName: Custom HLSL
  m_HLSLCode: "#include \"Assets/LineLab/Production/Shaders/AbilityCommon.hlsl\"\r\nvoid
    DrawAuthoredAbility(inout VFXAttributes attributes,\r\n    in float4 Start, in
    float4 End, in float4 Tint, in float4 Shape,\r\n    in StructuredBuffer<float4>
    Effects, in StructuredBuffer<float4> Ribbons,\r\n    in StructuredBuffer<float4>
    Layers, in StructuredBuffer<float4> Ramps,\r\n    in float Clock, in float3 CameraPosition,
    in float2 AtlasGrid)\r\n{\r\n    AbilityLine beam;\r\n    \r\n    beam.start
    = Start;\r\n    beam.end = End;\r\n    beam.color = Tint;\r\n    beam.shape =
    Shape;\r\n    uint effectIndex = (uint)beam.shape.x;\r\n    EffectRecipeData
    recipe = AbilityLoadEffect(Effects,effectIndex);\r\n    \r\n    uint ribbonSlot
    = (attributes.particleId % 96) / 32;\r\n    uint segment = attributes.particleId
    % 32;\r\n    RibbonRecipeData ribbon = AbilityLoadRibbon(Ribbons, effectIndex
    * 3 + ribbonSlot);\r\n    beam = AbilityStrand(beam, recipe, ribbon, Clock);\r\n   
    if (ribbonSlot >= recipe.Layout.x) beam.color.a = 0;\r\n    float t = (segment
    + 0.5) / 32;\r\n    float3 a = AbilityPoint(beam, recipe, (float)segment / 32,
    Clock);\r\n    float3 b = AbilityPoint(beam, recipe, (segment + 1.0) / 32, Clock);\r\n   
    float3 midpoint = (a + b) * 0.5;\r\n    float3 x = normalizesafe(b - a, float3(1,0,0));\r\n   
    float3 y = normalizesafe(cross(normalizesafe(CameraPosition-midpoint,float3(0,0,-1)),x),float3(0,1,0));\r\n   
    float4 tint = AbilityTint(beam, recipe, ribbon, Ramps, t, Clock);\r\n    attributes.position
    = midpoint;\r\n    attributes.axisX = x;\r\n    attributes.axisY = y;\r\n   
    attributes.axisZ = cross(x,y);\r\n    attributes.scaleX = distance(a,b) * 1.035;\r\n   
    attributes.scaleY = AbilityWidth(beam,ribbon,Ramps,t);\r\n    attributes.color
    = tint.rgb;\r\n    attributes.alpha = tint.a;\r\n    attributes.texIndex = (AtlasGrid.y
    - 1 - floor(ribbon.Surface.x / AtlasGrid.x)) * AtlasGrid.x + fmod(ribbon.Surface.x,
    AtlasGrid.x);\r\n    attributes.size = 1;\r\n    attributes.scaleZ = 1;\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawAuthoredAbility
    selectedIndex: 0

  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966675142}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966675161}
  - {fileID: 114350483966675162}
  - {fileID: 114350483966675163}
  - {fileID: 114350483966675164}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675160}
  m_BlockName: Custom HLSL
  m_HLSLCode: '#include "Assets/LineLab/Shaders/LineCommon.hlsl"

    void DrawLine(inout
    VFXAttributes attributes, in StructuredBuffer<float4> Lines, in uint Segments,
    in float Clock, in float3 CameraPosition)

    {

    LabLine l; uint index=(attributes.particleId/Segments)*4;
    l.start=Lines[index]; l.end=Lines[index+1]; l.color=Lines[index+2]; l.shape=Lines[index+3];

    uint
    segment=attributes.particleId%Segments; float t=(segment+.5)/Segments;

    float3
    a=LabPoint(l,(float)segment/Segments,Clock); float3 b=LabPoint(l,(float)(segment+1)/Segments,Clock);
    float3 mid=(a+b)*.5;

    float3 tangent=normalize(b-a+float3(1e-7,0,0)); float3
    side=normalize(cross(normalize(CameraPosition-mid),tangent)); float4 color=LabTint(l,t,Clock);

    attributes.position=mid;
    attributes.axisX=tangent; attributes.axisY=side; attributes.axisZ=normalize(cross(tangent,side));

    attributes.size=1;
    attributes.scaleX=distance(a,b)*1.035; attributes.scaleY=l.end.w; attributes.scaleZ=1;
    attributes.color=color.rgb; attributes.alpha=color.a;

    }'
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DrawLine
    selectedIndex: 0
